---
import BaseLayout from "../layouts/BaseLayout.astro";
import links from "../data/links.json";

const steps = [
  "Reimplement", "Reproduce", "Modify", "Experiment",
  "Find something interesting", "Form a hypothesis",
  "Run controlled experiments", "Publish",
];
---
<BaseLayout title="Research">
  <section class="section wrap">
    <p class="crumb prompt fade-up" style="--d: 0s">git checkout -b original-research</p>
    <h1 class="fade-up" style="--d: 0.06s">Research</h1>
    <p class="muted lede fade-up" style="--d: 0.12s">
      Work that goes beyond simple paper reproduction — genuine investigation,
      not just re-implementation. Nothing here is labeled "research" unless it
      goes beyond following an existing paper's method on the paper's own terms.
    </p>
  </section>

  <section class="section wrap">
    <h2>Research progression</h2>
    <p class="muted">The path from following papers to producing findings:</p>
    <ol class="pipeline">
      {steps.map((s, i) => (
        <li class="step fade-up" style={`--d: ${Math.min(0.15 + i * 0.06, 0.7)}s`}>
          <span class="step__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="step__label">{s}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap">
    <h2>Projects</h2>
    <table>
      <thead>
        <tr><th>Project</th><th>Status</th><th>Summary</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><a href={`${links.github}/tree/master/research/experiment-001`} target="_blank" rel="noopener noreferrer">experiment-001</a></td>
          <td><span class="tag">not started</span></td>
          <td class="muted">fill in once started</td>
        </tr>
      </tbody>
    </table>
  </section>
</BaseLayout>

<style>
  .crumb {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0 0 0.9rem;
  }
  .lede {
    max-width: 68ch;
  }
  .pipeline {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: stretch;
  }
  .step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 0.7rem 1.1rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .step:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -14px var(--glow-strong);
  }
  .step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -0.62rem;
    color: var(--accent);
    font-size: 0.85rem;
    z-index: 1;
  }
  .step__n {
    font-size: 1.15rem;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--accent-dim);
    transition: -webkit-text-stroke-color 0.2s ease;
  }
  .step:hover .step__n {
    -webkit-text-stroke-color: var(--accent);
  }
  .step__label {
    white-space: nowrap;
  }
</style>
