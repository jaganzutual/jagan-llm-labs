---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgressDashboard from "../components/ProgressDashboard.astro";
import PaperCard from "../components/PaperCard.astro";
import { withBase } from "../utils/url";
import links from "../data/links.json";
import roadmap from "../data/roadmap.json";
import papers from "../data/papers.json";

const firstPaper = papers.find((p) => p.n === 1);
const tickerItems = papers.map((p) => ({ n: p.n, title: p.title }));
---
<BaseLayout title="Home">
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__kicker prompt fade-up" style="--d: 0s">whoami</p>
        <h1 class="fade-up" style="--d: 0.08s">
          Building LLMs<br />
          <span class="grad-text">from first principles.</span>
        </h1>
        <p class="hero__lede fade-up" style="--d: 0.16s">
          Software engineer, learning how LLMs actually work — the math, the
          architectures, the training runs — well enough to work alongside
          researchers at frontier labs someday.
        </p>
        <p class="hero__lede fade-up" style="--d: 0.22s">
          No fixed deadline. Just papers, code, and honest results, documented
          in public as I go.
        </p>
        <div class="hero__cta fade-up" style="--d: 0.3s">
          <a class="pill-btn" href={withBase("/roadmap/")}>View the roadmap →</a>
          <a class="ghost-btn" href={withBase("/papers/")}>Browse papers</a>
          <a class="hero__link" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="hero__link" href={links.x} target="_blank" rel="noopener noreferrer">X / Twitter</a>
        </div>
      </div>

      <div class="hero__term fade-up" style="--d: 0.2s">
        <div class="term">
          <div class="term__bar">
            <span class="term__dot term__dot--r"></span>
            <span class="term__dot term__dot--y"></span>
            <span class="term__dot term__dot--g"></span>
            <span class="term__title">jagan@llm-lab: ~/public</span>
          </div>
          <div class="term__body">
            <p><span class="prompt">whoami</span></p>
            <p class="term__out">jagan — software engineer → llm engineer (in progress)</p>
            <p><span class="prompt">cat mission.txt</span></p>
            <p class="term__out">learn how modern llms are built — the math, the architectures, the training runs — well enough to work alongside frontier-lab researchers someday.</p>
            <p><span class="prompt">ls ./lab</span></p>
            <p class="term__out term__ls">
              <span>26 papers</span>
              <span>26 implementations</span>
              <span>11 experiments</span>
              <span>1 research quest</span>
            </p>
            <p><span class="prompt">./run --honest</span></p>
            <p class="term__out">everything starts at zero. no faked progress.<span class="term__caret">▮</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label="Papers being tracked">
    <span class="ticker__label">tracking //</span>
    <div class="ticker__viewport">
      <div class="ticker__track">
        {[0, 1].map((copy) => (
          <div class="ticker__group" aria-hidden={copy === 1 ? "true" : undefined}>
            {tickerItems.map((item) => (
              <span class="ticker__item">
                <span class="ticker__n">#{String(item.n).padStart(2, "0")}</span>
                {item.title}
                <span class="ticker__sep">◆</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="section wrap">
    <h2>Progress dashboard</h2>
    <p class="muted">Updated as the project progresses. Everything starts at zero — no faked progress.</p>
    <ProgressDashboard />
  </section>

  <section class="section wrap">
    <h2>Roadmap</h2>
    <p class="muted">6 phases, no fixed deadline. Full detail on the <a href={withBase("/roadmap/")}>roadmap page</a>.</p>
    <div class="grid phases">
      {roadmap.map((phase) => (
        <a class="card phase" href={withBase("/roadmap/")}>
          <span class="phase__num">{String(phase.phase).padStart(2, "0")}</span>
          <span class="tag">phase {phase.phase}</span>
          <h3>{phase.title}</h3>
          <p class="muted">{phase.papers.length} paper{phase.papers.length > 1 ? "s" : ""}</p>
          <span class="phase__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  {firstPaper && (
    <section class="section wrap">
      <h2>Up next</h2>
      <p class="muted">First milestone: read, implement, and run a small-scale experiment on Paper #1.</p>
      <div class="grid" style="grid-template-columns: minmax(0, 380px);">
        <div class="featured">
          <PaperCard paper={firstPaper} />
        </div>
      </div>
    </section>
  )}

  <section class="section wrap">
    <h2>How to read this repo</h2>
    <p class="muted">Five labels, never used interchangeably:</p>
    <table>
      <tbody>
        <tr><td><strong>Learning</strong></td><td>Understanding an existing, published concept.</td></tr>
        <tr><td><strong>Implementation</strong></td><td>Building an existing, published idea from scratch.</td></tr>
        <tr><td><strong>Reproduction</strong></td><td>Attempting to reproduce published findings (usually small-scale).</td></tr>
        <tr><td><strong>Experiment</strong></td><td>Modifying or testing an idea under controlled conditions.</td></tr>
        <tr><td><strong>Original Research</strong></td><td>Investigating a question beyond simply following a paper.</td></tr>
      </tbody>
    </table>
    <p class="muted">More in the <a href={withBase("/about/")}>about page</a>.</p>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding: 4.5rem 0 3.5rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
  }
  .hero__kicker {
    font-family: var(--mono);
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 5.6vw, 3.9rem);
    margin: 0 0 1.4rem;
  }
  .hero__lede {
    max-width: 56ch;
    color: var(--text);
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .hero__lede:last-of-type {
    margin-bottom: 0;
  }
  .hero__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }
  .hero__link {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .hero__link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* ---------- terminal window ---------- */
  .hero__term {
    min-width: 0;
  }
  .term {
    background: var(--bg-inset);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--glow),
      0 0 48px -10px var(--glow-strong),
      0 24px 48px -24px rgba(0, 0, 0, 0.6);
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
  }
  .term__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .term__dot--r { background: #ff5f56; }
  .term__dot--y { background: #ffbd2e; }
  .term__dot--g { background: #27c93f; }
  .term__title {
    margin-left: 0.5rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }
  .term__body {
    padding: 1.1rem 1.2rem 1.3rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .term__body p {
    margin: 0;
    overflow-wrap: break-word;
  }
  .term__body p + p {
    margin-bottom: 0.85rem;
  }
  .term__body p:last-child {
    margin-bottom: 0;
  }
  .term__out {
    color: var(--text-dim);
  }
  .term__ls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .term__ls span {
    color: var(--accent);
  }
  .term__caret {
    display: inline-block;
    margin-left: 0.45rem;
    color: var(--accent);
    animation: caret 1.1s steps(1) infinite;
  }
  @keyframes caret {
    50% { opacity: 0; }
  }

  /* ---------- paper ticker ---------- */
  .ticker {
    display: flex;
    align-items: center;
    border-block: 1px solid var(--border);
    background: var(--bg-raised);
    overflow: hidden;
  }
  .ticker__label {
    flex-shrink: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.7rem 1.1rem;
    border-right: 1px solid var(--border);
    background: var(--glow);
  }
  .ticker__viewport {
    overflow: hidden;
    flex: 1;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 90s linear infinite;
  }
  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }
  .ticker__group {
    display: flex;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0 0.7rem 1.4rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .ticker__n {
    color: var(--accent);
  }
  .ticker__sep {
    margin-left: 1.4rem;
    font-size: 0.55rem;
    color: var(--border-strong);
  }
  @keyframes ticker {
    to { transform: translateX(-50%); }
  }

  /* ---------- roadmap phases ---------- */
  .phases {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .phase {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--text);
    overflow: hidden;
  }
  .phase:hover {
    text-decoration: none;
  }
  .phase:hover .phase__num {
    -webkit-text-stroke-color: var(--accent);
    opacity: 1;
  }
  .phase h3 {
    margin: 0.35rem 0 0;
    font-size: 1rem;
  }
  .phase p {
    margin: 0 0 0.25rem;
  }
  .phase__num {
    position: absolute;
    right: 0.4rem;
    top: -0.55rem;
    font-family: var(--mono);
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border-strong);
    opacity: 0.55;
    transition: -webkit-text-stroke-color 0.2s ease, opacity 0.2s ease;
    pointer-events: none;
  }
  .phase__arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 0.9rem;
    font-family: var(--mono);
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .phase:hover .phase__arrow {
    opacity: 1;
    transform: none;
  }

  /* ---------- featured paper ---------- */
  .featured {
    padding: 6px;
    border-radius: calc(var(--radius) + 4px);
    background: linear-gradient(135deg, var(--glow-strong), transparent 55%);
    box-shadow: 0 0 0 1px var(--accent-dim), 0 0 44px -8px var(--glow-strong);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
    .hero {
      padding-top: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 0 2.5rem;
    }
    .hero__lede {
      font-size: 0.98rem;
    }
    .term__body {
      padding: 0.9rem 1rem 1.1rem;
      font-size: 0.74rem;
    }
    .term__ls {
      gap: 0.3rem 0.9rem;
    }
    .ticker__label {
      padding: 0.6rem 0.8rem;
      font-size: 0.66rem;
    }
    .ticker__item {
      font-size: 0.72rem;
      padding-left: 1rem;
    }
    .ticker__sep {
      margin-left: 1rem;
    }
    .featured {
      padding: 5px;
    }
  }

  @media (max-width: 480px) {
    .hero__cta {
      gap: 0.6rem;
    }
    .hero__cta .pill-btn,
    .hero__cta .ghost-btn {
      flex: 1 1 100%;
      justify-content: center;
    }
    .hero__link {
      flex: 1;
      text-align: center;
    }
  }
</style>
