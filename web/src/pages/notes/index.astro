---
import BaseLayout from "../../layouts/BaseLayout.astro";
import links from "../../data/links.json";

const notes = [
  "transformers", "attention", "tokenization", "pretraining", "scaling",
  "post-training", "reasoning", "moe", "inference", "research-methodology",
];
---
<BaseLayout title="Notes">
  <section class="section wrap">
    <p class="crumb prompt fade-up" style="--d: 0s">tree notes/ --topics</p>
    <h1 class="fade-up" style="--d: 0.06s">Notes</h1>
    <p class="muted lede fade-up" style="--d: 0.12s">
      Running technical notes by topic — a small learning wiki, updated as
      understanding develops. Full text lives in the repo's <code>notes/</code> folder.
    </p>
  </section>

  <section class="section wrap">
    <div class="notes-list">
      {notes.map((slug, i) => (
        <a
          class="note fade-up"
          style={`--d: ${Math.min(0.18 + i * 0.05, 0.7)}s`}
          href={`${links.github}/blob/master/notes/${slug}.md`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="note__icon" aria-hidden="true">▤</span>
          <span class="note__name">{slug}</span>
          <span class="note__ext">.md</span>
        </a>
      ))}
      <a
        class="note fade-up"
        style="--d: 0.75s"
        href={`${links.github}/blob/master/notes/x-posts.md`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="note__icon" aria-hidden="true">▤</span>
        <span class="note__name">x posts (templates + log)</span>
        <span class="note__ext">.md</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .crumb {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0 0 0.9rem;
  }
  .lede {
    max-width: 62ch;
  }
  .notes-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 0.7rem;
  }
  .note {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.84rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 0.75rem 0.95rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .note:hover {
    text-decoration: none;
    border-color: var(--accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -14px var(--glow-strong);
  }
  .note__icon {
    color: var(--accent);
    font-size: 0.9rem;
  }
  .note__name {
    color: var(--text);
  }
  .note:hover .note__name {
    color: var(--accent);
  }
  .note__ext {
    color: var(--text-dim);
    font-size: 0.72rem;
  }
</style>
