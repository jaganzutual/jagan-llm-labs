---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import papers from "../../data/papers.json";
import links from "../../data/links.json";

export function getStaticPaths() {
  return papers.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;

const levelIcon: Record<string, string> = {
  IMPLEMENT: "🟢",
  EXPERIMENT: "🟡",
  STUDY: "🔵",
};

const githubPath = `${links.github}/tree/master/papers/${paper.slug}`;
---
<BaseLayout title={paper.title}>
  <section class="section wrap">
    <p class="muted"><a href="/papers/">← all papers</a></p>
    <p class="tag">#{String(paper.n).padStart(2, "0")} · {levelIcon[paper.level]} {paper.level} · {paper.difficulty}</p>
    <h1>{paper.title}</h1>
    <p class="muted">{paper.authors} · {paper.year} · {paper.category}</p>

    <div class="status-row">
      <StatusBadge done={paper.status.read} label="read" />
      <StatusBadge done={paper.status.implemented} label="implemented" />
      <StatusBadge done={paper.status.experiment} label="experiment" />
    </div>

    <table>
      <tbody>
        <tr><td>Paper</td><td><a href={paper.link} target="_blank" rel="noopener noreferrer">{paper.link}</a></td></tr>
        <tr><td>Official implementation</td><td>{paper.official}</td></tr>
        <tr><td>Full writeup</td><td><a href={githubPath} target="_blank" rel="noopener noreferrer">View on GitHub →</a></td></tr>
      </tbody>
    </table>

    <p class="muted">
      The full writeup (problem, key idea, math, what was implemented, results,
      failures) lives in the paper's <a href={githubPath} target="_blank" rel="noopener noreferrer">GitHub folder</a> and
      is filled in as work on this paper progresses.
    </p>
  </section>
</BaseLayout>

<style>
  .status-row {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
  }
</style>
