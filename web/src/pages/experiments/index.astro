---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Meter from "../../components/Meter.astro";
import { withBase } from "../../utils/url";
import experiments from "../../data/experiments.json";

const done = experiments.filter((e) => e.status === "done").length;
const active = experiments.filter((e) => e.status === "in-progress").length;
const planned = experiments.length - done - active;
---
<BaseLayout title="Experiments">
  <section class="section wrap">
    <p class="crumb prompt fade-up" style="--d: 0s">./run-experiments --controlled</p>
    <h1 class="fade-up" style="--d: 0.06s">Experiments</h1>
    <p class="muted lede fade-up" style="--d: 0.12s">
      Controlled experiments — question → hypothesis → variables → results →
      analysis. Never "I tried this" notebooks.
    </p>
    <div class="stat-row fade-up" style="--d: 0.18s">
      <Meter label="done" value={done} total={experiments.length} />
      <Meter label="in progress" value={active} total={experiments.length} />
      <Meter label="planned" value={planned} total={experiments.length} />
    </div>
  </section>

  <section class="section wrap">
    <div class="grid exp-grid">
      {experiments.map((exp, i) => (
        <a class="card exp-card fade-up" style={`--d: ${Math.min(0.24 + i * 0.05, 0.8)}s`} href={withBase(`/experiments/${exp.slug}/`)}>
          <span class="exp-num" aria-hidden="true">{String(i + 1).padStart(3, "0")}</span>
          <span class="tag">exp {String(i + 1).padStart(3, "0")}</span>
          <h3>{exp.title}</h3>
          <p class="muted">{exp.related}</p>
          <span class="tag status">{exp.status}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .crumb {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0 0 0.9rem;
  }
  .lede {
    max-width: 62ch;
  }
  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .exp-grid {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .exp-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--text);
    overflow: hidden;
  }
  .exp-card:hover {
    text-decoration: none;
  }
  .exp-card:hover .exp-num {
    -webkit-text-stroke-color: var(--accent-dim);
    opacity: 0.9;
  }
  .exp-num {
    position: absolute;
    right: 0.5rem;
    bottom: -1.2rem;
    font-family: var(--mono);
    font-size: 4.2rem;
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border-strong);
    opacity: 0.45;
    transition: -webkit-text-stroke-color 0.2s ease, opacity 0.2s ease;
    pointer-events: none;
  }
  .exp-card h3,
  .exp-card p,
  .exp-card .tag {
    position: relative;
  }
  .exp-card h3 {
    margin: 0.2rem 0 0;
    font-size: 1rem;
  }
  .status {
    width: fit-content;
    margin-top: 0.3rem;
  }
</style>
