---
import links from "../data/links.json";
import { withBase } from "../utils/url";
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/", label: "home" },
  { href: "/roadmap/", label: "roadmap" },
  { href: "/papers/", label: "papers" },
  { href: "/experiments/", label: "experiments" },
  { href: "/research/", label: "research" },
  { href: "/notes/", label: "notes" },
  { href: "/progress/", label: "progress" },
  { href: "/about/", label: "about" },
];

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === "/") return path === withBase("/") || path === "/";
  return path.includes(href);
}
---
<div class="nav-backdrop">
  <div class="nav-shell">
    <a class="nav__brand" href={withBase("/")}>jagan-llm-lab<span class="nav__cursor">_</span></a>

    <header class="nav">
      <nav class="nav__links">
        {nav.map((item) => (
          <a href={withBase(item.href)} class={isActive(item.href) ? "is-active" : ""}>{item.label}</a>
        ))}
      </nav>
    </header>

    <div class="nav__actions">
      <ThemeToggle />
      <a class="nav__x" href={links.x} target="_blank" rel="noopener noreferrer">X →</a>
    </div>
  </div>
</div>

<style>
  .nav-backdrop {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 auto;
    max-width: 1100px;
    padding: 0.9rem 1.5rem;
  }
  .nav__brand {
    font-family: var(--mono);
    color: var(--text-bright);
    font-weight: 600;
    white-space: nowrap;
  }
  .nav__brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .nav__cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .nav {
    background: var(--nav-bg);
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    height: 48px;
    padding: 0 1.25rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    overflow-x: auto;
  }
  .nav__links a {
    color: var(--nav-text-dim);
    white-space: nowrap;
  }
  .nav__links a:hover {
    color: var(--nav-text);
    text-decoration: none;
  }
  .nav__links a.is-active {
    color: var(--accent);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .nav__x {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .nav__x:hover {
    color: var(--accent-blue);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .nav__links {
      gap: 0.8rem;
      font-size: 0.8rem;
      padding: 0 1rem;
    }
  }
</style>
