---
import links from "../data/links.json";
import { withBase } from "../utils/url";
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/", label: "home" },
  { href: "/roadmap/", label: "roadmap" },
  { href: "/papers/", label: "papers" },
  { href: "/experiments/", label: "experiments" },
  { href: "/research/", label: "research" },
  { href: "/notes/", label: "notes" },
  { href: "/progress/", label: "progress" },
  { href: "/about/", label: "about" },
];

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === "/") return path === withBase("/") || path === "/";
  return path.includes(href);
}
---
<div class="nav-backdrop">
  <div class="nav-shell">
    <a class="nav__brand" href={withBase("/")}>
      <span class="nav__mark" aria-hidden="true"></span>jagan-llm-lab<span class="nav__cursor">_</span>
    </a>

    <header class="nav">
      <nav class="nav__links">
        {nav.map((item) => (
          <a href={withBase(item.href)} class={isActive(item.href) ? "is-active" : ""}>{item.label}</a>
        ))}
      </nav>
    </header>

    <div class="nav__actions">
      <ThemeToggle />
      <a class="nav__x" href={links.x} target="_blank" rel="noopener noreferrer">X →</a>
    </div>
  </div>
</div>

<style>
  .nav-backdrop {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 auto;
    max-width: 1180px;
    padding: 0.8rem 1.5rem;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    color: var(--text-bright);
    font-weight: 700;
    white-space: nowrap;
    text-shadow: 0 0 22px var(--glow-strong);
  }
  .nav__mark {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow-strong), 0 0 22px var(--glow-strong);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .nav__brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .nav__cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .nav {
    background: var(--nav-bg);
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(203, 250, 76, 0.07);
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    height: 46px;
    padding: 0 0.5rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav__links::-webkit-scrollbar {
    display: none;
  }
  .nav__links a {
    color: var(--nav-text-dim);
    white-space: nowrap;
    padding: 0.32rem 0.7rem;
    border-radius: var(--radius-pill);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav__links a:hover {
    color: var(--nav-text);
    text-decoration: none;
    background: rgba(203, 250, 76, 0.09);
  }
  .nav__links a.is-active {
    color: var(--accent-ink);
    background: var(--accent);
    font-weight: 700;
    box-shadow: 0 0 18px var(--glow-strong);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .nav__x {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .nav__x:hover {
    color: var(--accent-blue);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .nav-shell {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }
    .nav {
      order: 3;
      width: 100%;
    }
    .nav__links {
      width: 100%;
      height: 44px;
      mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
      -webkit-overflow-scrolling: touch;
    }
  }

  @media (max-width: 720px) {
    .nav-shell {
      padding: 0.7rem 1rem;
    }
    .nav__links {
      gap: 0.1rem;
      font-size: 0.78rem;
      padding: 0 0.5rem;
    }
    .nav__links a {
      padding: 0.3rem 0.55rem;
    }
    .nav__x {
      display: none;
    }
  }
</style>
