---
import links from "../data/links.json";
import { withBase } from "../utils/url";
import ThemeToggle from "./ThemeToggle.astro";
import progress from "../data/progress.json";

const nav = [
  { href: "/", label: "home" },
  { href: "/roadmap/", label: "roadmap" },
  { href: "/papers/", label: "papers" },
  { href: "/experiments/", label: "experiments" },
  { href: "/research/", label: "research" },
  { href: "/notes/", label: "notes" },
  { href: "/progress/", label: "progress" },
  { href: "/about/", label: "about" },
];

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === "/") return path === withBase("/") || path === "/";
  return path.includes(href);
}

const totalUnits =
  progress.papersTotal + progress.implementationsTotal + progress.experimentsTotal + progress.researchTotal;
const loggedUnits =
  progress.papersRead + progress.implementations + progress.experiments + progress.researchProjects;
const loggedPct = totalUnits ? Math.round((loggedUnits / totalUnits) * 100) : 0;
---
<div class="nav-dock" id="nav-dock">
  <header class="dock">
    <a class="dock__brand" href={withBase("/")}>
      <span class="dock__mark" aria-hidden="true"></span>
      <span class="dock__brand-text">jagan-llm-lab<span class="dock__cursor">_</span></span>
    </a>

    <nav class="dock__nav" aria-label="Primary">
      <div class="dock__links">
        {nav.map((item) => (
          <a href={withBase(item.href)} class={isActive(item.href) ? "is-active" : ""}>{item.label}</a>
        ))}
      </div>
    </nav>

    <div class="dock__actions">
      <a class="dock__stat" href={withBase("/progress/")} title={`${loggedUnits} of ${totalUnits} units logged (${loggedPct}%)`}>
        <span class="dock__stat-dot" aria-hidden="true"></span>
        <span class="dock__stat-text">{loggedUnits}<span class="dock__stat-total">/{totalUnits}</span></span>
        <span class="dock__stat-bar" aria-hidden="true">
          <span class="dock__stat-fill" style={`width: ${loggedPct}%`}></span>
        </span>
      </a>
      <ThemeToggle />
      <a class="dock__icon" href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a class="dock__icon" href={links.x} target="_blank" rel="noopener noreferrer" aria-label="X / Twitter profile">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
      </a>
    </div>
  </header>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById("nav-dock");
    if (!el) return;
    var onScroll = function () {
      el.classList.toggle("is-scrolled", (window.scrollY || 0) > 8);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  .nav-dock {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    padding: 0 1rem;
    pointer-events: none;
    animation: dockIn 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  @keyframes dockIn {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .dock {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.55rem 0.75rem 0.55rem 1.1rem;
    background: color-mix(in srgb, var(--nav-bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.25);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    border: 1px solid rgba(203, 250, 76, 0.1);
    border-radius: var(--radius-pill);
    box-shadow:
      0 14px 40px -20px rgba(0, 0, 0, 0.7),
      0 0 32px -14px var(--glow-strong),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: box-shadow 0.25s ease, background-color 0.25s ease;
  }
  :global(.nav-dock.is-scrolled) .dock {
    background: color-mix(in srgb, var(--nav-bg) 88%, transparent);
    box-shadow:
      0 18px 48px -20px rgba(0, 0, 0, 0.85),
      0 0 36px -12px var(--glow-strong),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  /* brand */
  .dock__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--nav-text);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.92rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .dock__brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .dock__mark {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
    box-shadow: 0 0 10px var(--glow-strong), 0 0 24px var(--glow-strong);
    flex-shrink: 0;
  }
  .dock__cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  /* links */
  .dock__nav {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dock__nav::-webkit-scrollbar {
    display: none;
  }
  .dock__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-family: var(--mono);
    font-size: 0.82rem;
  }
  .dock__links a {
    color: var(--nav-text-dim);
    white-space: nowrap;
    padding: 0.32rem 0.7rem;
    border-radius: var(--radius-pill);
    transition: color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .dock__links a:hover {
    color: var(--nav-text);
    text-decoration: none;
    background: rgba(203, 250, 76, 0.09);
  }
  .dock__links a.is-active {
    color: var(--accent-ink);
    background: var(--accent);
    font-weight: 700;
    box-shadow: 0 0 18px var(--glow-strong);
  }

  /* actions */
  .dock__actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }
  .dock__stat {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--nav-text-dim);
    padding: 0.32rem 0.7rem;
    border: 1px solid rgba(203, 250, 76, 0.16);
    border-radius: var(--radius-pill);
    background: rgba(203, 250, 76, 0.05);
    transition: border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .dock__stat:hover {
    text-decoration: none;
    color: var(--accent);
    border-color: rgba(203, 250, 76, 0.45);
    box-shadow: 0 0 16px -2px var(--glow-strong);
  }
  .dock__stat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--glow-strong);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% { opacity: 0.45; }
  }
  .dock__stat-text {
    color: var(--nav-text);
    font-weight: 700;
  }
  .dock__stat-total {
    color: var(--nav-text-dim);
    font-weight: 500;
  }
  .dock__stat-bar {
    width: 42px;
    height: 4px;
    border-radius: 2px;
    background: rgba(203, 250, 76, 0.14);
    overflow: hidden;
  }
  .dock__stat-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent));
    box-shadow: 0 0 8px var(--glow-strong);
    transition: width 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .dock__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    color: var(--nav-text-dim);
    transition: color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .dock__icon:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
    box-shadow: 0 0 16px -2px var(--glow-strong);
    transform: translateY(-1px);
    text-decoration: none;
  }

  /* responsive */
  @media (max-width: 1150px) {
    .dock__stat {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .dock {
      flex-wrap: wrap;
      row-gap: 0.55rem;
      border-radius: 1.4rem;
      padding: 0.55rem 0.85rem;
    }
    .dock__nav {
      order: 3;
      width: 100%;
      mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
      -webkit-overflow-scrolling: touch;
    }
    .dock__links {
      width: 100%;
      padding-bottom: 0.15rem;
    }
  }
  @media (max-width: 480px) {
    .nav-dock {
      padding: 0 0.6rem;
      top: 0.5rem;
    }
    .dock__brand-text {
      font-size: 0.85rem;
    }
    .dock__links a {
      padding: 0.3rem 0.55rem;
    }
  }
</style>
