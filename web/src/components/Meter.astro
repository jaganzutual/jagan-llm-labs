---
interface Props {
  label: string;
  value: number;
  total: number;
}
const { label, value, total } = Astro.props;
const pct = total ? Math.round((value / total) * 100) : 0;
---
<span class="meter">
  <span class="meter__label">{label}</span>
  <span class="meter__bar" aria-hidden="true">
    <span class="meter__fill" style={`width: ${pct}%`}></span>
  </span>
  <span class="meter__value">{value}<span class="meter__total">/{total}</span></span>
</span>

<style>
  .meter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-raised);
  }
  .meter__label {
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.68rem;
  }
  .meter__bar {
    width: 56px;
    height: 4px;
    border-radius: 2px;
    background: var(--bg-inset);
    overflow: hidden;
  }
  .meter__fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent));
    box-shadow: 0 0 8px var(--glow-strong);
    transition: width 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .meter__value {
    color: var(--text-bright);
    font-weight: 700;
  }
  .meter__total {
    color: var(--text-dim);
    font-weight: 500;
  }
</style>
