---
import progress from "../data/progress.json";

const metrics = [
  { label: "papers read", value: progress.papersRead, total: progress.papersTotal },
  { label: "implementations", value: progress.implementations, total: progress.implementationsTotal },
  { label: "experiments", value: progress.experiments, total: progress.experimentsTotal },
  { label: "research projects", value: progress.researchProjects, total: progress.researchTotal },
];
---
<div class="dashboard">
  {metrics.map((m) => (
    <div class="metric card">
      <span class="metric__value">{m.value}<span class="metric__total"> / {m.total}</span></span>
      <span class="metric__label">{m.label}</span>
      <div class="metric__bar">
        <div class="metric__fill" style={`width: ${m.total ? (m.value / m.total) * 100 : 0}%`}></div>
      </div>
    </div>
  ))}
  <div class="metric card">
    <span class="metric__value metric__value--inf">∞</span>
    <span class="metric__label">weeks active</span>
    <p class="metric__note muted">no fixed end date — grows as the lab does</p>
  </div>
</div>

<style>
  .dashboard {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
    gap: 1rem;
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .metric__value {
    font-family: var(--mono);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-bright);
    text-shadow: 0 0 24px var(--glow-strong);
  }
  .metric__value--inf {
    color: var(--accent);
  }
  .metric__total {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-dim);
    text-shadow: none;
  }
  .metric__label {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .metric__bar {
    margin-top: 0.45rem;
    height: 5px;
    background: var(--bg-inset);
    border-radius: 3px;
    overflow: hidden;
  }
  .metric__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent));
    box-shadow: 0 0 12px var(--glow-strong);
    border-radius: 3px;
    transition: width 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .metric__note {
    font-size: 0.75rem;
    margin: 0.2rem 0 0;
  }
</style>
