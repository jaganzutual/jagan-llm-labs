---
interface Props {
  done: boolean;
  label: string;
}
const { done, label } = Astro.props;
---
<span class:list={["badge", { done }]}>
  <span class="dot" aria-hidden="true"></span>{label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.15rem 0.55rem 0.15rem 0.4rem;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .badge.done {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
  .badge.done .dot {
    background: var(--accent);
  }
</style>
