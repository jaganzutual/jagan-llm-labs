---
import links from "../data/links.json";
---
<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__brand">jagan-llm-lab<span class="footer__cursor">_</span></p>
    <p class="muted">
      Building LLMs From First Principles — a growing, in-public LLM research lab. No fixed deadline.
    </p>
    <p class="footer__links">
      <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={links.x} target="_blank" rel="noopener noreferrer">X / Twitter</a>
      <span aria-hidden="true">·</span>
      <a href={`${links.github}/blob/master/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 2rem;
    padding: 2.2rem 0 3rem;
    font-family: var(--mono);
    font-size: 0.82rem;
  }
  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-dim), transparent);
    opacity: 0.55;
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .footer__brand {
    margin: 0 0 0.3rem;
    color: var(--text-bright);
    font-weight: 700;
  }
  .footer__cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .footer__inner p {
    margin: 0;
  }
  .footer__links {
    margin-top: 0.3rem !important;
  }
  .footer__links a {
    color: var(--text-dim);
  }
  .footer__links a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .footer__links span {
    color: var(--border-strong);
    margin: 0 0.35rem;
  }
</style>
